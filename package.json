{
  "name": "thinkbigwithaitutor",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -n server,web -c blue,green \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "tsx watch --env-file-if-exists=.env server/index.ts",
    "dev:web": "vite",
    "build": "vite build",
    "start": "tsx --env-file-if-exists=.env server/index.ts",
    "typecheck": "tsc --noEmit",
    "bank:generate": "tsx --env-file-if-exists=.env scripts/generateBank.ts",
    "bank:build": "tsx scripts/buildBank.ts",
    "test": "node --import tsx --test \"shared/**/*.test.ts\" \"server/**/*.test.ts\" \"agents/**/*.test.ts\""
  },
  "dependencies": {
    "@google/genai": "^3.6.1",
    "@remotion/player": "^4.0.545",
    "express": "^5.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "remotion": "^4.0.545",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^10.0.7",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
}
